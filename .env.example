VITE_SUPABASE_URL=
# Clé « publishable » (publique par conception, protégée par les politiques RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Uniquement pour `npm run db:apply` — chaîne de connexion Postgres du projet; ne jamais commiter ni préfixer par VITE_
SUPABASE_DB_URL=

# Web Push: générés par `npm run push:setup`
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
DISPATCH_SECRET=
